---
import Logo from './Logo.astro';
import { LOTERIAS } from '../lib/loterias';
---
<header class="hdr">
  <div class="wrap hdr-in">
    <Logo />
    <nav class="nav" aria-label="Principal">
      <div class="dd">
        <button class="nav-a" aria-expanded="false" aria-haspopup="true">Resultados <span aria-hidden="true">▾</span></button>
        <div class="dd-menu">
          {LOTERIAS.map((l) => (
            <a href={`/${l.slug}/`} style={`--c:${l.cor}`}><span class="dot"></span>{l.nome}</a>
          ))}
        </div>
      </div>
      <a class="nav-a" href="/rio-de-premios/">Rio de Prêmios</a>
      <a class="nav-a" href="/estatisticas/">Estatísticas</a>
      <a class="nav-a" href="/ferramentas/">Ferramentas</a>
      <a class="nav-a" href="/guias/">Guias</a>
      <a class="nav-virada" href="/mega-da-virada/">✦ Mega da Virada</a>
    </nav>
    <div class="hdr-act">
      <button class="icon-btn" id="theme" aria-label="Alternar tema claro/escuro">
        <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <button class="icon-btn burger" id="burger" aria-label="Abrir menu" aria-expanded="false" aria-controls="mnav">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <div class="mnav" id="mnav" hidden>
    <div class="wrap">
      <a class="mnav-virada" href="/mega-da-virada/">✦ Mega da Virada {new Date().getFullYear()}</a>
      <a class="mnav-rp" href="/rio-de-premios/">Rio de Prêmios — loteria do RJ</a>
      <p class="mnav-h">Resultados</p>
      <div class="mnav-grid">
        {LOTERIAS.map((l) => <a href={`/${l.slug}/`} style={`--c:${l.cor}`}><span class="dot"></span>{l.nome}</a>)}
      </div>
      <p class="mnav-h">Mais</p>
      <div class="mnav-grid">
        <a href="/estatisticas/">Estatísticas</a><a href="/ferramentas/">Ferramentas</a><a href="/guias/">Guias</a><a href="/sobre/">Sobre</a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const r = document.documentElement;
    document.getElementById('theme')?.addEventListener('click', () => {
      const dark = r.dataset.theme ? r.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      r.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('theme', r.dataset.theme); } catch (e) {}
    });
    const b = document.getElementById('burger'), m = document.getElementById('mnav');
    b?.addEventListener('click', () => { const o = m.hidden; m.hidden = !o; b.setAttribute('aria-expanded', String(o)); });
    document.querySelectorAll('.dd > button').forEach((btn) => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); const o = btn.getAttribute('aria-expanded') === 'true'; btn.setAttribute('aria-expanded', String(!o)); });
    });
    document.addEventListener('click', () => document.querySelectorAll('.dd > button').forEach((x) => x.setAttribute('aria-expanded', 'false')));
  })();
</script>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 72%, transparent); backdrop-filter: blur(18px) saturate(160%); -webkit-backdrop-filter: blur(18px) saturate(160%); border-bottom: 1px solid var(--line); }
  .hdr-in { display: flex; align-items: center; gap: 24px; height: 68px; }
  .nav { display: flex; align-items: center; gap: 4px; margin-left: auto; }
  .nav-a { padding: 9px 13px; border-radius: 999px; font: 550 .93rem var(--font); color: var(--muted); text-decoration: none; background: none; border: 0; cursor: pointer; }
  .nav-a:hover, .nav-a[aria-expanded="true"] { color: var(--text); background: var(--surface2); }
  .nav-virada { margin-left: 6px; padding: 9px 16px; border-radius: 999px; font: 650 .93rem var(--font); text-decoration: none; color: #1c1400; background: linear-gradient(120deg, #f6d36b, #e3a92c); box-shadow: 0 8px 24px -10px rgba(227,169,44,.8); }
  .nav-virada:hover { color: #1c1400; filter: brightness(1.05); }
  .dd { position: relative; }
  .dd-menu { position: absolute; top: calc(100% + 10px); left: -8px; width: 260px; padding: 8px; border-radius: 16px; background: var(--surface-solid); border: 1px solid var(--line); box-shadow: var(--shadow-lg); display: none; }
  .dd > button[aria-expanded="true"] + .dd-menu, .dd:focus-within .dd-menu { display: grid; }
  @media (hover: hover) { .dd:hover .dd-menu { display: grid; } .dd::after { content: ''; position: absolute; top: 100%; left: 0; right: 0; height: 12px; } }
  .dd-menu a { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 10px; text-decoration: none; font-weight: 550; font-size: .93rem; }
  .dd-menu a:hover { background: var(--surface2); color: var(--text); }
  .hdr-act { display: flex; gap: 6px; }
  .icon-btn { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); color: var(--text); cursor: pointer; }
  .i-moon { display: none; }
  :global([data-theme="dark"]) .i-sun { display: none; } :global([data-theme="dark"]) .i-moon { display: block; }
  .burger { display: none; }
  .mnav { border-top: 1px solid var(--line); padding: 16px 0 24px; max-height: calc(100vh - 68px); overflow-y: auto; }
  .mnav-h { font-size: .72rem; text-transform: uppercase; letter-spacing: .12em; color: var(--faint); margin: 18px 0 8px; font-weight: 700; }
  .mnav-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .mnav-grid a { display: flex; align-items: center; gap: 10px; padding: 11px 12px; border-radius: 12px; background: var(--surface2); text-decoration: none; font-weight: 550; font-size: .93rem; }
  .mnav-rp { display: block; text-align: center; padding: 13px; margin-top: 8px; border-radius: 14px; font-weight: 700; text-decoration: none; color: #04211f; background: linear-gradient(120deg, #2dd4bf, #f2c14e); }
  .mnav-virada { display: block; text-align: center; padding: 14px; border-radius: 14px; font-weight: 700; text-decoration: none; color: #1c1400; background: linear-gradient(120deg, #f6d36b, #e3a92c); }
  @media (max-width: 1080px) { .nav { display: none; } .burger { display: grid; } .hdr-act { margin-left: auto; } }
</style>
