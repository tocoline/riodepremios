    <rect x="1" y="1" width="38" height="38" rx="12" fill="url(#lg1)"/>
    <circle cx="15" cy="16" r="5.2" fill="#fff" fill-opacity=".95"/>
    <circle cx="25.5" cy="16" r="5.2" fill="#fff" fill-opacity=".75"/>
