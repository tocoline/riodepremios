---
import { AUTORA } from '../lib/site';
// modo "autora": conteúdo editorial escrito/revisado pela autora.
// modo "auto": página gerada automaticamente a partir de dados oficiais (com responsável editorial).
interface Props { atualizado?: string; revisado?: boolean; modo?: 'autora' | 'auto' }
const { atualizado, revisado = true, modo = 'autora' } = Astro.props;
const quando = atualizado ? new Date(atualizado) : null;
const href = `/autores/${AUTORA.slug}/`;
---
<div class="autor">
  <a href={href} class="av" aria-hidden="true" tabindex="-1"><img src={AUTORA.fotoP} alt="" width="44" height="44" loading="lazy" decoding="async" /></a>
  <div>
    {modo === 'autora' ? (
      <p class="nm">Por <a href={href} rel="author">{AUTORA.nome}</a> <span class="cg">· {AUTORA.cargo}</span>{revisado && <span class="pill ok">✓ Dados conferidos</span>}</p>
    ) : (
      <p class="nm">Publicado automaticamente com dados oficiais <span class="cg">· Responsável editorial: <a href={href}>{AUTORA.nome}</a></span></p>
    )}
    <p class="small faint">
      {quando && <>Atualizado em <time datetime={quando.toISOString()}>{quando.toLocaleString('pt-BR', { dateStyle: 'long', timeStyle: 'short', timeZone: 'America/Sao_Paulo' })}</time> · </>}
      <a href="/metodologia/">Fontes e metodologia</a>
    </p>
  </div>
</div>
<style>
  .autor { display: flex; gap: 12px; align-items: center; margin: 18px 0 0; }
  .av { width: 44px; height: 44px; border-radius: 50%; overflow: hidden; flex: none; box-shadow: 0 0 0 2px var(--surface), 0 0 0 4px color-mix(in srgb, var(--brand) 60%, transparent); }
  .av img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .nm { margin: 0; font-weight: 600; font-size: .92rem; display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
  .cg { font-weight: 500; color: var(--muted); }
  .autor p { margin: 0; }
</style>
