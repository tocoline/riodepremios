---
import { SITE } from '../lib/site';
interface Props { atualizado?: string; revisado?: boolean }
const { atualizado, revisado = true } = Astro.props;
const quando = atualizado ? new Date(atualizado) : null;
---
<div class="autor">
  <div class="av" aria-hidden="true">RP</div>
  <div>
    <p class="nm">Por <a href="/sobre/equipe-editorial/" rel="author">{SITE.editor.nome}</a>{revisado && <span class="pill ok">✓ Dados conferidos</span>}</p>
    <p class="small faint">
      {quando && <>Atualizado em <time datetime={quando.toISOString()}>{quando.toLocaleString('pt-BR', { dateStyle: 'long', timeStyle: 'short', timeZone: 'America/Sao_Paulo' })}</time> · </>}
      <a href="/metodologia/">Fontes e metodologia</a>
    </p>
  </div>
</div>
<style>
  .autor { display: flex; gap: 12px; align-items: center; margin: 18px 0 0; }
  .av { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; font: 700 .8rem var(--display); color: #06140e; background: var(--grad); flex: none; }
  .nm { margin: 0; font-weight: 600; font-size: .92rem; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .autor p { margin: 0; }
</style>
