---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada" description="A página que você procura não existe." noindex>
  <section class="narrow section" style="text-align:center">
    <div class="balls" style="justify-content:center;margin-bottom:22px"><span class="ball lg">4</span><span class="ball lg gold">0</span><span class="ball lg">4</span></div>
    <h1>Essa combinação não saiu</h1>
    <p class="lead" style="margin-inline:auto">A página que você procura não existe ou mudou de endereço.</p>
    <p><a class="btn btn-primary" href="/">Ver resultados de hoje</a></p>
  </section>
</Base>
