---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import StatsView from '../../components/StatsView.astro';
import EstatSecoes from '../../components/EstatSecoes.astro';
import Resposta from '../../components/Resposta.astro';
import Fonte from '../../components/Fonte.astro';
import Ad from '../../components/Ad.astro';
import { POR_SLUG } from '../../lib/loterias';
import { getDB, ultimos, dbFalhou } from '../../lib/db';
import { calcular } from '../../lib/estatisticas';
import { resumo } from '../../lib/resumo';
import { pad, numero } from '../../lib/format';
import { cachear, naoEncontrado, indisponivel } from '../../lib/cache';

const l = POR_SLUG[Astro.params.loteria!];
if (!l || l.tipo === 'colunas') return naoEncontrado(Astro);
cachear(Astro, 1800);
const db = getDB(Astro.locals);
const [r, [ult]] = await Promise.all([resumo(db, l), ultimos(db, l, 1)]);
if (!r && dbFalhou(db)) return indisponivel();
const s = r?.s ?? calcular(l, []);
const porAno = r?.porAno ?? [];
const anos = r?.anos ?? [];
---
<Base title={`Estatísticas da ${l.nome}: dezenas que mais saem e atrasadas`} description={`Estatísticas da ${l.nome} com ${numero(s.total)} concursos: dezenas mais sorteadas, mais atrasadas, pares e ímpares e frequência por ano, atualizadas a cada sorteio.`} modificado={ult?.atualizado_em}>
  <div class="wrap phero">
    <Crumbs itens={[{ nome: l.nome, url: `/${l.slug}/` }, { nome: 'Estatísticas' }]} />
    <h1>Estatísticas da {l.nome}</h1>
    <p class="lead">Frequência de todas as dezenas{s.total ? `, com base em ${s.total.toLocaleString('pt-BR')} concursos` : ''}. Atualizado automaticamente a cada sorteio.</p>
  </div>
  <section class="wrap">
    {s.total > 0 && (
      <Resposta>
        <p>Os números que mais saíram na {l.nome} são <strong>{s.mais.slice(0, 6).map((x) => pad(x.dezena)).join(', ')}</strong>. A dezena mais atrasada é a <strong>{pad(s.atrasadas[0].dezena)}</strong>, que não sai há {s.atrasadas[0].atraso} concursos. A combinação de pares e ímpares mais comum é {s.paresImpares[0]?.[0].replace('p/', ' pares e ').replace('i', ' ímpares')}.</p>
      </Resposta>
    )}
    <Fonte atualizado={ult?.atualizado_em} />
    <h2>Mapa de frequência</h2>
    <StatsView l={l} s={s} />
    <Ad />
    <EstatSecoes l={l} s={s} porAno={porAno} concursosPorAno={anos} />
  </section>
</Base>
