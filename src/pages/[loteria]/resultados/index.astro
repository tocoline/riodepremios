---
export const prerender = false;
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import Bolas from '../../../components/Bolas.astro';
import Resposta from '../../../components/Resposta.astro';
import Fonte from '../../../components/Fonte.astro';
import AnosNav from '../../../components/AnosNav.astro';
import EstatSecoes from '../../../components/EstatSecoes.astro';
import Ad from '../../../components/Ad.astro';
import { POR_SLUG, diasTexto } from '../../../lib/loterias';
import { getDB, lista as listar, dbFalhou } from '../../../lib/db';
import { calcular } from '../../../lib/estatisticas';
import { resumo } from '../../../lib/resumo';
import { dataBR, reaisCurto, numero, pad } from '../../../lib/format';
import { cachear, naoEncontrado, indisponivel } from '../../../lib/cache';

const l = POR_SLUG[Astro.params.loteria!];
if (!l) return naoEncontrado(Astro);
// paginação antiga (?pagina= / ?page=) aponta para a página canônica
if (Astro.url.searchParams.has('pagina') || Astro.url.searchParams.has('page')) return Astro.redirect(`/${l.slug}/resultados/`, 301);
cachear(Astro, 600);
const db = getDB(Astro.locals);
const [{ itens }, r] = await Promise.all([listar(db, l, 1, 30), resumo(db, l)]);
if (!itens.length && dbFalhou(db)) return indisponivel();
const total = r?.total ?? itens.length;
const anos = r?.anos ?? [];
const porAno = r?.porAno ?? [];
const s = r?.s ?? calcular(l, []);
const ult = itens[0];
const dig = l.tipo === 'colunas' ? 1 : 2;
---
<Base title={`Resultados da ${l.nome}: todos os concursos por ano`} description={`Histórico de resultados da ${l.nome}: ${numero(total)} concursos com dezenas, datas e prêmios, organizados por ano, mais as dezenas que mais saem e as mais atrasadas.`} modificado={ult?.atualizado_em}>
  <div class="wrap phero">
    <Crumbs itens={[{ nome: l.nome, url: `/${l.slug}/` }, { nome: 'Resultados' }]} />
    <h1>Resultados da {l.nome}</h1>
    <p class="lead">Todos os concursos da {l.nome} organizados por ano, com as dezenas sorteadas, os prêmios e as estatísticas do histórico.</p>
  </div>
  <section class="wrap">
    <Resposta>
      {ult ? <p>O último resultado da {l.nome} é o do <a href={`/${l.slug}/concurso/${ult.numero}/`}><strong>concurso {ult.numero}</strong></a> ({dataBR(ult.data)}): <strong>{ult.dezenas.map((d) => pad(d, dig)).join(' - ')}</strong>. Os sorteios acontecem às {diasTexto(l)}, às 20h. Nosso arquivo tem <strong>{numero(total)} concursos</strong>, organizados por ano abaixo.</p>
           : <p>O histórico da {l.nome} está sendo sincronizado automaticamente.</p>}
    </Resposta>
    <Fonte atualizado={ult?.atualizado_em} />

    <h2>Resultados por ano</h2>
    <p class="muted">Escolha o ano para ver a lista completa de concursos, com dezenas e prêmios.</p>
    <AnosNav slug={l.slug} nome={l.nome} anos={anos} />

    <h2>Últimos 30 resultados</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Concurso</th><th>Data</th><th>Dezenas</th><th>Situação</th><th class="num">Prêmio principal</th></tr></thead>
        <tbody>
          {itens.map((c) => (
            <tr>
              <td><a href={`/${l.slug}/concurso/${c.numero}/`}><strong>{c.numero}</strong></a></td>
              <td>{dataBR(c.data)}</td>
              <td><Bolas dezenas={c.dezenas} cor={l.cor} tam="sm" digitos={dig} /></td>
              <td>{c.acumulado ? <span class="pill hot">Acumulou</span> : <span class="pill ok">Ganhador</span>}</td>
              <td class="num">{c.premiacoes[0]?.ganhadores ? reaisCurto(c.premiacoes[0].premio) : '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <Ad />
    <EstatSecoes l={l} s={s} porAno={porAno} concursosPorAno={anos} faqExtra={[{ q: `Onde vejo resultados antigos da ${l.nome}?`, a: `Na seção "Resultados por ano" desta página: cada ano tem a lista completa de concursos, com dezenas e prêmios.` }]} />
  </section>
</Base>
<style> td .balls { flex-wrap: nowrap; } </style>
