---
export const prerender = false;
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import Bolas from '../../../components/Bolas.astro';
import Resposta from '../../../components/Resposta.astro';
import Fonte from '../../../components/Fonte.astro';
import AnosNav from '../../../components/AnosNav.astro';
import Ad from '../../../components/Ad.astro';
import { POR_SLUG, MESES } from '../../../lib/loterias';
import { getDB, anos as listarAnos, doAno } from '../../../lib/db';
import { dataBR, reais, reaisCurto, numero } from '../../../lib/format';
import { cachear, naoEncontrado } from '../../../lib/cache';
import { SITE } from '../../../lib/site';

const l = POR_SLUG[Astro.params.loteria!];
const ano = Number(Astro.params.ano);
if (!l || !/^\d{4}$/.test(Astro.params.ano ?? '')) return naoEncontrado(Astro);
const db = getDB(Astro.locals);
const anos = await listarAnos(db, l);
const info = anos.find((a) => a.ano === ano);
if (!info) return naoEncontrado(Astro);
const completo = info.completo;
const lista = await doAno(db, l, ano);
const anoAtual = new Date().getFullYear();
cachear(Astro, ano < anoAtual && completo ? 86400 : 900);

const dig = l.tipo === 'colunas' ? 1 : 2;
const acumulados = lista.filter((c) => c.acumulado).length;
const comGanhador = lista.filter((c) => !c.acumulado && c.premiacoes[0]?.ganhadores);
const maior = [...comGanhador].sort((a, b) => (b.premiacoes[0].premio ?? 0) - (a.premiacoes[0].premio ?? 0))[0];
const primeiro = lista.at(-1), ultimo = lista[0];
const atualizado = lista.reduce((m, c) => (c.atualizado_em > m ? c.atualizado_em : m), '');
const porMes = new Map<number, typeof lista>();
for (const c of lista) { const m = Number(c.data.slice(5, 7)); if (!porMes.has(m)) porMes.set(m, []); porMes.get(m)!.push(c); }

const titulo = `Resultados da ${l.nome} ${ano}: todos os concursos`;
const desc = `Todos os ${lista.length} concursos da ${l.nome} em ${ano}${primeiro && ultimo ? ` (do ${primeiro.numero} ao ${ultimo.numero})` : ''}: dezenas sorteadas, datas, prêmios e quando acumulou.`;
const schema = [{
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: titulo, description: desc, inLanguage: 'pt-BR',
  url: `${SITE.url}/${l.slug}/resultados/${ano}/`, isPartOf: { '@id': `${SITE.url}/#site` }, dateModified: atualizado || undefined,
  mainEntity: { '@type': 'ItemList', numberOfItems: lista.length, itemListElement: lista.slice(0, 100).map((c, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}/${l.slug}/concurso/${c.numero}/`, name: `${l.nome} ${c.numero}` })) },
}];
---
<Base title={titulo} description={desc} schema={schema} modificado={atualizado || undefined} noindex={!completo}>
  <div class="wrap phero">
    <Crumbs itens={[{ nome: l.nome, url: `/${l.slug}/` }, { nome: 'Resultados', url: `/${l.slug}/resultados/` }, { nome: String(ano) }]} />
    <h1>Resultados da {l.nome} {ano}</h1>
    <p class="lead">Lista completa dos concursos de {ano}, do mais recente ao mais antigo, com as dezenas sorteadas e o prêmio principal de cada um.</p>
  </div>
  <section class="wrap">
    {!completo && <div class="card aviso-ano"><strong>Arquivo em atualização.</strong> Ainda estamos importando os concursos de {ano} dos dados oficiais da Caixa. A lista completa aparece aqui automaticamente nos próximos dias.</div>}
    <Resposta>
      <p>Em {ano}, a {l.nome} teve <strong>{lista.length} concursos</strong> registrados{primeiro && ultimo ? <>, do <a href={`/${l.slug}/concurso/${primeiro.numero}/`}>{primeiro.numero}</a> ({dataBR(primeiro.data)}) ao <a href={`/${l.slug}/concurso/${ultimo.numero}/`}>{ultimo.numero}</a> ({dataBR(ultimo.data)})</> : ''}. O prêmio principal acumulou em <strong>{acumulados}</strong> deles e saiu em <strong>{comGanhador.length}</strong>.{maior ? <> O maior prêmio pago por aposta foi de <strong>{reais(maior.premiacoes[0].premio)}</strong>, no <a href={`/${l.slug}/concurso/${maior.numero}/`}>concurso {maior.numero}</a>.</> : ''}</p>
    </Resposta>
    <Fonte atualizado={atualizado} />
    <h2>Outros anos</h2>
    <AnosNav slug={l.slug} nome={l.nome} anos={anos} atual={ano} />

    {[...porMes.entries()].map(([m, cs], i) => (
      <>
        <h2 id={`mes-${m}`}>{MESES[m - 1]} de {ano} <span class="faint small">· {cs.length} concurso{cs.length > 1 ? 's' : ''}</span></h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Concurso</th><th>Data</th><th>Dezenas</th><th>Situação</th><th class="num">Prêmio principal</th></tr></thead>
            <tbody>
              {cs.map((c) => (
                <tr>
                  <td><a href={`/${l.slug}/concurso/${c.numero}/`}><strong>{c.numero}</strong></a></td>
                  <td>{dataBR(c.data)}</td>
                  <td><Bolas dezenas={c.dezenas} cor={l.cor} tam="sm" digitos={dig} /></td>
                  <td>{c.acumulado ? <span class="pill hot">Acumulou</span> : <span class="pill ok">{numero(c.premiacoes[0]?.ganhadores ?? 0)} ganhador(es)</span>}</td>
                  <td class="num">{c.premiacoes[0]?.ganhadores ? reaisCurto(c.premiacoes[0].premio) : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {i === 1 && <Ad />}
      </>
    ))}
    <p class="small faint" style="margin-top:16px">Clique no número do concurso para ver a premiação completa, os ganhadores por cidade e a análise das dezenas.</p>
  </section>
</Base>
<style> .aviso-ano { margin-bottom: 16px; border-color: color-mix(in srgb, var(--gold) 40%, var(--line)); } td .balls { flex-wrap: nowrap; } h2 { margin-top: 28px; } </style>
