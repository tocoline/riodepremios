---
export const prerender = false;
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import Bolas from '../../../components/Bolas.astro';
import Resposta from '../../../components/Resposta.astro';
import Ad from '../../../components/Ad.astro';
import Autor from '../../../components/Autor.astro';
import Countdown from '../../../components/Countdown.astro';
import Palpites from '../../../components/Palpites.astro';
import TabelasLoteria from '../../../components/TabelasLoteria.astro';
import Faq from '../../../components/Faq.astro';
import { POR_SLUG, DIAS, diasTexto, VIRADA } from '../../../lib/loterias';
import { getDB, concurso, vizinhos, ultimos, anteriores } from '../../../lib/db';
import { gerarPalpites, frequencias } from '../../../lib/palpites';
import { chancePrincipal } from '../../../lib/conteudo';
import { dataBR, reais, reaisCurto, numero, pad } from '../../../lib/format';
import { cachear, naoEncontrado } from '../../../lib/cache';
import { SITE } from '../../../lib/site';

const l = POR_SLUG[Astro.params.loteria!];
const n = Number(Astro.params.numero);
if (!l || !Number.isInteger(n) || n < 1) return naoEncontrado(Astro);
const db = getDB(Astro.locals);
const c = await concurso(db, l, n);

// Sem resultado: só existe página se for o PRÓXIMO concurso (pré-sorteio)
const [ult] = c ? [null] : await ultimos(db, l, 1);
const ehVirada = l.slug === 'mega-sena' && n === VIRADA.concurso;
const prox = !c && ult && (ult.proximo_numero === n || (ehVirada && ult.numero < n)) ? ult : null;
if (!c && !prox) return naoEncontrado(Astro);

const hist = await anteriores(db, l, n, 100);
const palpites = gerarPalpites(l, n, hist);
const viz = c ? await vizinhos(db, l, n) : { anterior: ult!.numero, proximo: null };
cachear(Astro, c ? (Date.now() - new Date(c.data).getTime() > 7 * 864e5 ? 86400 : 300) : 300);

const dig = l.tipo === 'colunas' ? 1 : 2;
const dataSorteio = c ? c.data : ehVirada ? VIRADA.data.slice(0, 10) : prox!.proximo_data;
const horaTxt = ehVirada ? VIRADA.hora : '20h';
const diaSemana = dataSorteio ? DIAS[new Date(dataSorteio + 'T12:00:00Z').getUTCDay()] : '';
const dataCurta = dataSorteio ? dataBR(dataSorteio).slice(0, 5) : '';
const sorteioISO = ehVirada ? VIRADA.data : dataSorteio ? `${dataSorteio}T20:00:00-03:00` : null;
const imagem = `/imagem-concurso.png?l=${l.slug}&n=${n}${c ? '&r=1' : ''}`;
const dz = c?.dezenas.map((d) => pad(d, dig)).join(' - ') ?? '';

// contexto pré-sorteio
const freq = l.tipo !== 'colunas' ? frequencias(l, hist) : [];
const quentes = [...freq].sort((a, b) => b.vezes - a.vezes || a.dezena - b.dezena).slice(0, 10);
const atrasadas = [...freq].sort((a, b) => b.atraso - a.atraso || a.dezena - b.dezena).slice(0, 10);
let seguidas = 0;
for (let i = hist.length - 1; i >= 0 && hist[i].acumulado; i--) seguidas++;
if (ehVirada) seguidas = 0;
const premio = ehVirada ? VIRADA.premioValor : prox?.proximo_numero === n ? prox?.proximo_estimativa : null;
const premioTxt = ehVirada ? VIRADA.premioTexto : premio ? reaisCurto(premio) : null;

const ESPECIAIS: Record<string, string> = { 'mega-sena': 'Mega da Virada', lotofacil: 'Lotofácil da Independência', quina: 'Quina de São João', 'dupla-sena': 'Dupla de Páscoa' };
const nomeEspecial = c?.especial ? ESPECIAIS[l.slug] : undefined;
const anoEspecial = c ? Number(c.data.slice(0, 4)) - (l.slug === 'mega-sena' && c.data.slice(5, 7) === '01' ? 1 : 0) : 0;
const titulo = c
  ? nomeEspecial ? `${nomeEspecial} ${anoEspecial}: resultado do concurso ${n}` : `Resultado ${l.nome} ${n} de ${dataBR(c.data)}: dezenas sorteadas`
  : ehVirada ? `Mega da Virada ${VIRADA.ano}: resultado do concurso ${n} (${VIRADA.dataCurta}), palpites e prêmio de ${premioTxt}` : `Resultado ${l.nome} ${n} (${dataCurta}): palpites${premioTxt ? ` e ${premioTxt}` : ' e horário'}`;
const desc = c
  ? `${l.nome} ${n} (${dataBR(c.data)}): ${dz}. ${c.acumulado ? 'Acumulou.' : 'Teve ganhador.'} Premiação, ganhadores por cidade e como foram os palpites.`
  : `${ehVirada ? `Mega da Virada ${VIRADA.ano}, ` : ''}${l.nome} concurso ${n}: sorteio ${diaSemana}, ${dataBR(dataSorteio)}, às ${horaTxt}.${premioTxt ? ` Prêmio estimado de ${premioTxt}.` : ''} Palpites estatísticos, dezenas quentes e atrasadas e resultado ao vivo nesta página.`;
const publicado = c ? `${c.data}T21:00:00-03:00` : (ult!.atualizado_em ?? new Date().toISOString());
const modificado = c ? c.atualizado_em : (ult!.atualizado_em ?? new Date().toISOString());
const schema = [{
  '@context': 'https://schema.org', '@type': 'NewsArticle', headline: titulo, description: desc, inLanguage: 'pt-BR',
  image: [new URL(imagem, SITE.url).href], datePublished: publicado, dateModified: modificado,
  mainEntityOfPage: `${SITE.url}/${l.slug}/concurso/${n}/`,
  author: { '@type': 'Organization', name: SITE.editor.nome, url: `${SITE.url}/sobre/` },
  publisher: { '@type': 'Organization', name: SITE.nome, logo: { '@type': 'ImageObject', url: `${SITE.url}/icon-512.png` } },
}];
const faqPre = prox ? [
  { q: `Que horas sai o resultado da ${l.nome} ${n}?`, a: `O sorteio do concurso ${n} acontece ${diaSemana}, ${dataBR(dataSorteio, true).replace(/^[^,]+, /, '')}, às ${horaTxt} (horário de Brasília)${ehVirada ? `, no ${VIRADA.local}` : ''}. O resultado aparece nesta mesma página poucos minutos depois, automaticamente.` },
  { q: `Qual é o prêmio da ${l.nome} ${n}?`, a: premioTxt ? `O prêmio estimado para o concurso ${n} é de ${ehVirada ? premioTxt : reais(premio!)}${seguidas > 0 ? `, depois de ${seguidas} concurso(s) seguido(s) sem ganhador na faixa principal` : ''}. O valor final é divulgado pela Caixa após o sorteio.` : 'A Caixa divulga a estimativa de prêmio após o concurso anterior. Ela aparece aqui automaticamente.' },
  { q: 'Até que horas posso apostar?', a: ehVirada ? 'Apostas individuais até 31 de dezembro de 2026, às 22h. Bolões digitais nos canais da Caixa até 9h de 1º de janeiro de 2027.' : 'Em geral, as apostas ficam abertas até as 19h (horário de Brasília) do dia do sorteio, nas lotéricas, no app Loterias Caixa e no portal Loterias Online. Não deixe para a última hora.' },
  { q: `Quanto custa e qual a chance de ganhar?`, a: `A aposta mínima custa ${reais(l.preco)} e a chance de acertar a faixa principal com ela é de 1 em ${numero(chancePrincipal(l))}.` },
  { q: 'Onde assistir ao sorteio?', a: 'Os sorteios são transmitidos ao vivo pelos canais oficiais da Caixa nas redes sociais. Se preferir, acompanhe por aqui: a página é atualizada sozinha quando o resultado sai.' },
] : [];
---
<Base title={titulo} description={desc} schema={schema} image={imagem} type="article" modificado={modificado}>
  <div class="wrap phero">
    <Crumbs itens={[{ nome: l.nome, url: `/${l.slug}/` }, { nome: 'Resultados', url: `/${l.slug}/resultados/` }, { nome: `Concurso ${n}` }]} />
    {c?.especial && <span class="pill hot">✦ Concurso especial</span>}
    {ehVirada && <span class="pill hot">✦ Mega da Virada {VIRADA.ano}</span>} {prox && <span class="pill hot">⏳ Ainda não sorteado</span>}
    <h1>{c ? `${l.nome} — resultado do concurso ${n}` : ehVirada ? `Mega da Virada ${VIRADA.ano} — concurso ${n}: palpites e resultado` : `${l.nome} ${n}: palpites e resultado de ${diaSemana} (${dataCurta})`}</h1>
    <p class="lead">{c
      ? `Sorteio realizado em ${dataBR(c.data, true)}${c.local ? `, em ${c.local}` : ''}.`
      : `Sorteio ${diaSemana}, ${dataBR(dataSorteio, true).replace(/^[^,]+, /, '')}, às ${horaTxt} (Brasília)${ehVirada ? `, no ${VIRADA.local}` : ''}. Esta página mostra o resultado automaticamente assim que ele sair.`}</p>
    <Autor atualizado={modificado} />
  </div>

  {prox ? (
    <>
      <section class="wrap cgrid">
        <div class="card big pre" style={`--c:${l.cor}`}>
          <p class="lbl">Contagem regressiva para o sorteio</p>
          {sorteioISO && <div class="cd-wrap"><Countdown alvo={sorteioISO} /></div>}
          {premioTxt ? <div class="prz"><span class="lbl">Prêmio estimado</span><strong>{premioTxt}</strong>{seguidas > 0 && <span class="pill hot">Acumulado há {seguidas} concurso{seguidas > 1 ? 's' : ''}</span>}</div> : null}
          <div class="acts">
            <a class="btn btn-primary btn-sm" href="#palpites">Ver palpites</a>
            <a class="btn btn-sm" href={`/ferramentas/gerador-de-numeros/`}>Gerar meus jogos</a>
          </div>
        </div>
        <div class="side">
          <Resposta>
            <p>O concurso <strong>{n} da {l.nome}</strong> será sorteado <strong>{diaSemana}, {dataBR(dataSorteio)}, às {horaTxt}</strong> (horário de Brasília).{premioTxt ? <> O prêmio estimado é de <strong>{premioTxt}</strong>.</> : ''}{ehVirada ? <> É a <a href="/mega-da-virada/">Mega da Virada {VIRADA.ano}</a>, que não acumula.</> : ''} A aposta mínima custa {reais(l.preco)}. O resultado será publicado nesta página automaticamente, minutos após o sorteio.</p>
          </Resposta>
          <figure class="hero-img"><img src={imagem} alt={`${l.nome} concurso ${n} — ${dataBR(dataSorteio)}`} width="1200" height="675" loading="eager" /></figure>
        </div>
      </section>

      <div class="wrap"><Ad /></div>
      <section class="wrap section-sm" id="palpites"><Palpites l={l} palpites={palpites} numero={n} /></section>

      {quentes.length > 0 && hist.length >= 10 && (
        <section class="wrap section-sm">
          <h2>Dezenas quentes e atrasadas antes do concurso {n}</h2>
          <p class="muted">Com base nos últimos {hist.length} concursos da {l.nome} (até o {ult!.numero}).</p>
          <div class="grid g2">
            <div class="card"><h3>🔥 Mais sorteadas</h3><Bolas dezenas={quentes.map((q) => q.dezena)} cor={l.cor} tam="sm" /><p class="small faint" style="margin:10px 0 0">{quentes.slice(0, 3).map((q) => `${pad(q.dezena)} saiu ${q.vezes} vezes`).join(' · ')}</p></div>
            <div class="card"><h3>⏳ Mais atrasadas</h3><Bolas dezenas={atrasadas.map((q) => q.dezena)} cor="#d9a521" tam="sm" /><p class="small faint" style="margin:10px 0 0">{atrasadas.slice(0, 3).map((q) => `${pad(q.dezena)} há ${q.atraso} concursos`).join(' · ')}</p></div>
          </div>
          <p><a href={`/${l.slug}/estatisticas/`}>Ver estatísticas completas da {l.nome} →</a></p>
        </section>
      )}

      <section class="wrap section-sm">
        <h2>Último resultado: concurso {ult!.numero}</h2>
        <a class="card card-link lastc" href={`/${l.slug}/concurso/${ult!.numero}/`}>
          <div><strong>{l.nome} {ult!.numero}</strong> <span class="faint small">· {dataBR(ult!.data)}</span></div>
          <Bolas dezenas={ult!.dezenas} cor={l.cor} tam="sm" digitos={dig} />
          {ult!.acumulado ? <span class="pill hot">Acumulou</span> : <span class="pill ok">Teve ganhador</span>}
        </a>
      </section>

      <div class="wrap"><Ad /></div>
      <section class="wrap section-sm">
        <h2>Como apostar no concurso {n}</h2>
        <div class="prose" style="max-width:820px">
          <p>A {l.nome} sorteia às {diasTexto(l)}. Para concorrer no concurso {n}, faça sua aposta em uma lotérica, no app Loterias Caixa ou no portal Loterias Online até o horário de encerramento do dia {dataBR(dataSorteio)}. Veja o <a href={`/${l.slug}/como-jogar/`}>guia completo de como jogar</a>.</p>
        </div>
        <TabelasLoteria l={l} />
      </section>
      <section class="section-sm"><div class="narrow"><Faq itens={faqPre} titulo={`Dúvidas sobre a ${l.nome} ${n}`} /></div></section>
    </>
  ) : c && (
    <>
      <section class="wrap cgrid">
        <div class="card big" style={`--c:${l.cor}`}>
          <p class="lbl">Dezenas sorteadas</p>
          <Bolas dezenas={c.dezenas} cor={l.cor} tam="lg" digitos={dig} />
          {c.dezenas2 && (<><p class="lbl">2º sorteio</p><Bolas dezenas={c.dezenas2} cor={l.cor2} tam="lg" /></>)}
          {c.extra?.trevos && (<><p class="lbl">Trevos</p><Bolas dezenas={c.extra.trevos} cor="#d9a521" digitos={1} tam="lg" /></>)}
          {c.extra?.time && <p class="ext">⚽ Time do Coração: <strong>{c.extra.time}</strong></p>}
          {c.extra?.mes && <p class="ext">📅 Mês da Sorte: <strong>{c.extra.mes}</strong></p>}
          {c.dezenas_ordem && l.tipo !== 'colunas' && <p class="small faint">Ordem do sorteio: {c.dezenas_ordem.map((d) => pad(d, dig)).join(' · ')}</p>}
          <div class="acts">
            <a class="btn btn-primary btn-sm" href={`/ferramentas/conferidor/?loteria=${l.slug}&concurso=${c.numero}`}>Conferir minha aposta</a>
            {c.acumulado ? <span class="pill hot">Acumulou!</span> : <span class="pill ok">Teve ganhador na faixa principal</span>}
          </div>
        </div>
        <div class="side">
          <Resposta>
            <p>O resultado da <strong>{l.nome} {c.numero}</strong> ({dataBR(c.data)}) foi <strong>{dz}</strong>{c.dezenas2 ? ` no 1º sorteio e ${c.dezenas2.map((d) => pad(d)).join(' - ')} no 2º sorteio` : ''}.
            {c.acumulado ? ' Ninguém acertou a faixa principal.' : ` ${c.premiacoes[0]?.ganhadores ?? ''} aposta(s) acertaram a faixa principal${c.premiacoes[0]?.premio ? `, levando ${reais(c.premiacoes[0].premio)} cada` : ''}.`}
            {c.proximo_numero ? <> O <a href={`/${l.slug}/concurso/${c.proximo_numero}/`}>próximo concurso ({c.proximo_numero})</a>{c.proximo_estimativa ? ` tem prêmio estimado em ${reaisCurto(c.proximo_estimativa)}` : ''}.</> : ''}</p>
          </Resposta>
          <figure class="hero-img"><img src={imagem} alt={`Resultado ${l.nome} ${n}: ${dz}`} width="1200" height="675" loading="eager" /></figure>
        </div>
      </section>

      <section class="wrap section-sm">
        <h2>Premiação</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Faixa</th><th class="num">Ganhadores</th><th class="num">Prêmio por ganhador</th></tr></thead>
            <tbody>{c.premiacoes.map((p) => <tr><td>{p.descricao}</td><td class="num">{numero(p.ganhadores)}</td><td class="num">{p.ganhadores ? reais(p.premio) : '—'}</td></tr>)}</tbody>
          </table>
        </div>
        {c.arrecadacao ? <p class="small faint" style="margin-top:10px">Arrecadação total: {reais(c.arrecadacao)}.</p> : null}
      </section>

      {c.cidades_ganhadoras && (
        <section class="wrap section-sm">
          <h2>Onde saíram os prêmios principais</h2>
          <div class="table-wrap"><table>
            <thead><tr><th>Cidade</th><th>UF</th><th class="num">Ganhadores</th></tr></thead>
            <tbody>{c.cidades_ganhadoras.map((g) => <tr><td>{g.cidade || 'Canal eletrônico'}</td><td>{g.uf}</td><td class="num">{g.ganhadores}</td></tr>)}</tbody>
          </table></div>
        </section>
      )}

      <div class="wrap"><Ad /></div>
      <section class="wrap section-sm"><Palpites l={l} palpites={palpites} numero={n} resultado={c.dezenas} resultado2={c.dezenas2} trevosSorteados={c.extra?.trevos} /></section>
      {c.proximo_numero && (
        <section class="wrap section-sm">
          <a class="card card-link nextc" href={`/${l.slug}/concurso/${c.proximo_numero}/`}>
            <div><span class="lbl">Próximo concurso</span><h3>{l.nome} {c.proximo_numero}{c.proximo_data && ` · ${dataBR(c.proximo_data)}`}</h3></div>
            {c.proximo_estimativa ? <strong class="nx-v">{reaisCurto(c.proximo_estimativa)}</strong> : null}
            <span class="btn btn-primary btn-sm">Ver palpites →</span>
          </a>
        </section>
      )}
    </>
  )}

  <nav class="wrap pager" aria-label="Concursos vizinhos">
    {viz.anterior ? <a class="btn" href={`/${l.slug}/concurso/${viz.anterior}/`} rel="prev">← Concurso {viz.anterior}</a> : <span></span>}
    <a class="btn" href={`/${l.slug}/`}>Último resultado</a>
    {viz.proximo ? <a class="btn" href={`/${l.slug}/concurso/${viz.proximo}/`} rel="next">Concurso {viz.proximo} →</a> : <span></span>}
  </nav>
</Base>
<style>
  .cgrid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 22px; align-items: start; }
  .big { display: flex; flex-direction: column; gap: 14px; border-top: 3px solid var(--c); }
  .lbl { margin: 0; font-size: .72rem; text-transform: uppercase; letter-spacing: .12em; color: var(--faint); font-weight: 700; }
  .ext { margin: 0; color: var(--muted); }
  .acts { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-top: 6px; }
  .side { display: grid; gap: 16px; }
  .hero-img { margin: 0; border-radius: var(--r); overflow: hidden; border: 1px solid var(--line); box-shadow: var(--shadow); }
  .hero-img img { width: 100%; height: auto; display: block; }
  .pre .cd-wrap :global(.cd-u) { background: var(--surface2); border-color: var(--line); }
  .pre .cd-wrap :global(.cd-v) { color: var(--text); }
  .pre .cd-wrap :global(.cd-l) { color: var(--faint); }
  .prz { display: flex; flex-direction: column; gap: 4px; align-items: flex-start; }
  .prz strong { font: 700 clamp(2rem, 5vw, 3rem)/1.05 var(--display); color: var(--gold); letter-spacing: -.03em; }
  .lastc { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .nextc { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; justify-content: space-between; border: 1px solid color-mix(in srgb, var(--gold) 35%, var(--line)); }
  .nextc h3 { margin: 4px 0 0; }
  .nx-v { font: 700 1.6rem var(--display); color: var(--gold); }
  .pager { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-top: 24px; }
  @media (max-width: 900px) { .cgrid { grid-template-columns: 1fr; } }
</style>
