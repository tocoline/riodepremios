---
// Endereços antigos: /resultado/<loteria>-concurso-<n>/
export const prerender = false;
import { destinoResultado } from '../../lib/legado';
import { naoEncontrado } from '../../lib/cache';
const slug = (Astro.params.slug ?? '').replace(/\/+$/, '').split('/').pop() ?? '';
const destino = destinoResultado(slug);
if (destino) return Astro.redirect(destino, 301);
return naoEncontrado(Astro);
---
