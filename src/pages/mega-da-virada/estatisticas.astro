---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import ViradaHero from '../../components/ViradaHero.astro';
import ViradaNav from '../../components/ViradaNav.astro';
import StatsView from '../../components/StatsView.astro';
import Resposta from '../../components/Resposta.astro';
import Ad from '../../components/Ad.astro';
import { POR_SLUG } from '../../lib/loterias';
import { getDB, historicoDezenas } from '../../lib/db';
import { calcular } from '../../lib/estatisticas';
import { pad } from '../../lib/format';
import { cachear } from '../../lib/cache';

cachear(Astro, 3600);
const l = { ...POR_SLUG['mega-sena'], cor: '#d9a521' };
const s = calcular(l, await historicoDezenas(getDB(Astro.locals), l, true));
---
<Base title="Estatísticas da Mega da Virada: números que mais saíram" description="Quais números mais saíram na Mega da Virada? Frequência de todas as dezenas em todas as edições, mapa de calor, mais atrasadas e combinações de pares e ímpares.">
  <ViradaHero titulo="Estatísticas da Mega da Virada" crumb="Estatísticas" sub="Análise exclusiva considerando apenas os concursos especiais de fim de ano." />
  <ViradaNav />
  <section class="wrap section-sm">
    {s.total > 0 && (
      <Resposta><p>Considerando {s.total} edições da Mega da Virada, as dezenas que mais saíram foram <strong>{s.mais.slice(0, 6).map((x) => `${pad(x.dezena)} (${x.vezes}×)`).join(', ')}</strong>. Com tão poucas edições, as diferenças de frequência são estatisticamente pequenas — trate como curiosidade.</p></Resposta>
    )}
    <div style="margin-top:22px"><StatsView l={l} s={s} rotulo="edições" /></div>
    <p><a href="/mega-sena/estatisticas/">Ver estatísticas de todos os concursos da Mega-Sena →</a></p>
    <Ad />
  </section>
</Base>
