---
export const prerender = false;
// Uma edição da Mega da Virada: resultado (já sorteada) ou, para a edição atual, a página que vira o resultado ao vivo.
import ViradaResultado from '../../components/ViradaResultado.astro';
import ViradaPreSorteio from '../../components/ViradaPreSorteio.astro';
import { POR_SLUG, VIRADA } from '../../lib/loterias';
import { getDB, especiais, ultimos, dbFalhou } from '../../lib/db';
import { anoDe } from '../../lib/virada';
import { rateioCompleto } from '../../lib/sincronizar';
import { cachear, naoEncontrado, indisponivel } from '../../lib/cache';

const ano = Number(Astro.params.ano);
if (!/^\d{4}$/.test(Astro.params.ano ?? '') || ano < 2008 || ano > VIRADA.ano) return naoEncontrado(Astro);
const db = getDB(Astro.locals);
const l = POR_SLUG['mega-sena'];
const todas = await especiais(db, l);                      // mais recente primeiro
if (!todas.length && dbFalhou(db)) return indisponivel();
const c = todas.find((x) => anoDe(x) === ano) ?? null;
if (!c && ano !== VIRADA.ano) return naoEncontrado(Astro);
const [ultMega] = c ? [null] : await ultimos(db, l, 1);
// resultado recente ou sem rateio: cache curto (o rateio e as cidades chegam depois das dezenas)
const recente = c && (!rateioCompleto(c.premiacoes) || Date.now() - new Date(c.atualizado_em).getTime() < 3 * 86400e3);
cachear(Astro, !c ? 300 : recente ? 120 : 86400);
---
{c ? <ViradaResultado c={c} todas={todas} /> : <ViradaPreSorteio todas={todas} ultMega={ultMega ?? null} />}
