---
export const prerender = false;
import Base from '../../layouts/Base.astro';
import RpHero from '../../components/RpHero.astro';
import RpNav from '../../components/RpNav.astro';
import RpAviso from '../../components/RpAviso.astro';
import Ad from '../../components/Ad.astro';
import { RP, proximaEdicao, dataEdicao, edicoesPublicadas } from '../../lib/riodepremios';
import { dataBR } from '../../lib/format';
import { cachear } from '../../lib/cache';
cachear(Astro, 1800);
const prox = proximaEdicao();
const lista = edicoesPublicadas().reverse();
---
<Base title="Resultados do Rio de Prêmios: todas as edições" description="Todas as edições do Rio de Prêmios, a loteria oficial do RJ: datas dos sorteios, próximas edições e onde conferir cada resultado oficial.">
  <RpHero titulo="Resultados do Rio de Prêmios" sub="Todas as edições, com data do sorteio e link para conferir o resultado oficial." crumbs={[{ nome: 'Rio de Prêmios', url: '/rio-de-premios/' }, { nome: 'Resultados' }]} />
  <RpNav />
  <section class="wrap section-sm">
    <div class="table-wrap"><table>
      <thead><tr><th>Edição</th><th>Data do sorteio</th><th>Situação</th><th></th></tr></thead>
      <tbody>{lista.map((n) => (
        <tr>
          <td><a href={`/rio-de-premios/edicao/${n}/`}><strong>{n}</strong></a></td>
          <td>Domingo, {dataBR(dataEdicao(n))}</td>
          <td>{n < prox ? <span class="pill ok">Realizado</span> : n === prox ? <span class="pill hot">Próximo sorteio</span> : <span class="pill">Em breve</span>}</td>
          <td><a href={`/rio-de-premios/edicao/${n}/`}>Ver edição →</a></td>
        </tr>
      ))}</tbody>
    </table></div>
    <p class="small faint" style="margin-top:12px">Os números e ganhadores de cada sorteio são publicados no site oficial: <a href={RP.siteOficial} rel="noopener nofollow" target="_blank">riodepremiosoficial.com.br</a>.</p>
    <RpAviso />
    <Ad />
  </section>
</Base>
