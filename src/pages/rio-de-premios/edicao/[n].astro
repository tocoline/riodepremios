---
export const prerender = false;
import Base from '../../../layouts/Base.astro';
import RpHero from '../../../components/RpHero.astro';
import RpNav from '../../../components/RpNav.astro';
import RpAviso from '../../../components/RpAviso.astro';
import Resposta from '../../../components/Resposta.astro';
import Faq from '../../../components/Faq.astro';
import Ad from '../../../components/Ad.astro';
import Autor from '../../../components/Autor.astro';
import { RP, proximaEdicao, dataEdicao, isoSorteio } from '../../../lib/riodepremios';
import { dataBR } from '../../../lib/format';
import { cachear, naoEncontrado } from '../../../lib/cache';
import { SITE, autoraLD } from '../../../lib/site';

const n = Number(Astro.params.n);
const prox = proximaEdicao();
const ultimaPublicada = prox + RP.edicoesFuturas - 1;
if (!Number.isInteger(n) || n < RP.baseEdicao || n > ultimaPublicada) return naoEncontrado(Astro);
cachear(Astro, 1800);

const realizada = n < prox;
const data = dataEdicao(n);
const dataLonga = dataBR(data, true).replace(/^[^,]+, /, '');
const imagem = `/imagem-concurso.png?l=rio-de-premios&n=${n}${realizada ? '&r=1' : ''}`;
const oficial = `<a href="${RP.siteOficial}" rel="noopener nofollow" target="_blank">riodepremiosoficial.com.br</a>`;

// Dicas que variam por edição (evita páginas idênticas)
const DICAS = [
  ['Cadastre o bilhete logo após a compra', 'O registro no site oficial vincula o bilhete aos seus dados e facilita a identificação em caso de prêmio.'],
  ['Fotografe frente e verso', 'Uma foto nítida ajuda se o bilhete original for perdido ou danificado.'],
  ['Compre só em canais oficiais', 'Evite vendedores informais e perfis não oficiais nas redes sociais.'],
  ['Não compartilhe o código do bilhete', 'Quem tem o código pode tentar usá-lo indevidamente. Guarde-o como uma senha.'],
  ['Confira o resultado no site oficial', 'O resultado oficial é sempre o publicado pelo Rio de Prêmios/LOTERJ.'],
  ['Desconfie de taxas para liberar prêmio', 'Nenhum prêmio exige pagamento antecipado. Mensagens assim são golpe.'],
  ['Defina um limite de gastos', 'Loteria é entretenimento. Decida antes quanto pretende gastar por mês.'],
  ['Leia o regulamento da edição', 'Prêmios, prazos de resgate e regras de cada sorteio estão no regulamento oficial.'],
];
const dicas = Array.from({ length: 4 }, (_, i) => DICAS[(n * 3 + i * 5) % DICAS.length]).filter((d, i, a) => a.indexOf(d) === i);

const titulo = realizada
  ? `Resultado Rio de Prêmios ${n} (${dataBR(data)}): como conferir`
  : `Resultado Rio de Prêmios ${n} — domingo, ${dataBR(data)}`;
const desc = realizada
  ? `Rio de Prêmios edição ${n}, sorteada no domingo ${dataBR(data)}: veja onde conferir o resultado oficial, como resgatar o prêmio e a próxima edição (${prox}).`
  : `Rio de Prêmios edição ${n}: sorteio no domingo, ${dataLonga}. Como participar, cadastrar o bilhete e onde conferir o resultado.`;
const publicado = new Date(Date.parse(isoSorteio(n)) - 14 * 864e5).toISOString();
const modificado = realizada ? new Date(Date.parse(isoSorteio(n)) + 6 * 3600e3).toISOString() : new Date().toISOString().slice(0, 10) + 'T06:00:00-03:00';
const schema = [{
  '@context': 'https://schema.org', '@type': 'NewsArticle', headline: titulo, description: desc, inLanguage: 'pt-BR',
  image: [new URL(imagem, SITE.url).href], datePublished: publicado, dateModified: modificado,
  mainEntityOfPage: `${SITE.url}/rio-de-premios/edicao/${n}/`,
  author: { '@type': 'Organization', name: SITE.nome, url: SITE.url }, editor: autoraLD(),
  publisher: { '@type': 'Organization', name: SITE.nome, logo: { '@type': 'ImageObject', url: `${SITE.url}/icon-512.png` } },
}];
const faq = [
  { q: `Quando é o sorteio do Rio de Prêmios ${n}?`, a: `A edição ${n} do Rio de Prêmios ${realizada ? 'foi sorteada' : 'será sorteada'} no domingo, ${dataLonga}. Confira o horário e a transmissão na divulgação oficial.` },
  { q: `Onde ver o resultado do Rio de Prêmios ${n}?`, a: `O resultado oficial é publicado no site ${oficial} e divulgado na transmissão do sorteio.` },
  realizada
    ? { q: 'Qual é a próxima edição?', a: `A próxima é a <a href="/rio-de-premios/edicao/${prox}/">edição ${prox}</a>, no domingo, ${dataBR(dataEdicao(prox))}.` }
    : { q: 'Até quando posso comprar o bilhete?', a: 'As vendas da edição se encerram antes do sorteio. Compre e cadastre seu bilhete com antecedência pelo site oficial.' },
  { q: 'Meu bilhete foi premiado. E agora?', a: 'Confirme no resultado oficial e siga as orientações de resgate do regulamento. Veja o guia <a href="/rio-de-premios/como-resgatar/">como resgatar o prêmio</a>.' },
];
---
<Base title={titulo} description={desc} schema={schema} image={imagem} type="article" modificado={modificado}>
  <RpHero titulo={`Rio de Prêmios ${n}`} sub={realizada ? `Sorteio realizado no domingo, ${dataLonga}.` : `Sorteio no domingo, ${dataLonga}.`}
    crumbs={[{ nome: 'Rio de Prêmios', url: '/rio-de-premios/' }, { nome: `Edição ${n}` }]} alvo={realizada ? undefined : isoSorteio(n)} tag={realizada ? 'Sorteio realizado' : n === prox ? 'Próximo sorteio' : 'Em breve'} />
  <RpNav />

  <section class="wrap section-sm rpe">
    <div>
      <Resposta>
        {realizada ? (
          <p>A <strong>edição {n} do Rio de Prêmios</strong> foi sorteada no <strong>domingo, {dataBR(data)}</strong>. O resultado oficial, com os números e os ganhadores de cada sorteio, está no site <a href={RP.siteOficial} rel="noopener nofollow" target="_blank">riodepremiosoficial.com.br</a>. A próxima edição é a <a href={`/rio-de-premios/edicao/${prox}/`}>{prox}</a>, em {dataBR(dataEdicao(prox))}.</p>
        ) : (
          <p>A <strong>edição {n} do Rio de Prêmios</strong> será sorteada no <strong>domingo, {dataBR(data)}</strong>. Para participar, compre e cadastre o bilhete no site oficial antes do encerramento das vendas. O resultado oficial será publicado em <a href={RP.siteOficial} rel="noopener nofollow" target="_blank">riodepremiosoficial.com.br</a>.</p>
        )}
      </Resposta>
      <Autor atualizado={modificado} modo="auto" />
      <RpAviso />
      {realizada && <p><a class="btn btn-primary" href={RP.siteOficial} rel="noopener nofollow" target="_blank">Ver resultado oficial da edição {n} ↗</a></p>}
    </div>
    <figure class="rpe-img"><img src={imagem} alt={`Rio de Prêmios edição ${n} — ${dataBR(data)}`} width="1200" height="675" loading="eager" /></figure>
  </section>

  <section class="wrap section-sm">
    {realizada ? (
      <>
        <h2>Como conferir o resultado da edição {n}</h2>
        <ol class="steps">
          <li class="card"><span class="sn">1</span><div><h3>Acesse o site oficial</h3><p class="muted">O resultado de cada sorteio da edição {n} é publicado em riodepremiosoficial.com.br.</p></div></li>
          <li class="card"><span class="sn">2</span><div><h3>Tenha o bilhete em mãos</h3><p class="muted">Compare os números do seu bilhete com os de cada sorteio da edição.</p></div></li>
          <li class="card"><span class="sn">3</span><div><h3>Foi premiado? Siga o regulamento</h3><p class="muted">Confira prazos e documentos no regulamento e veja nosso guia <a href="/rio-de-premios/como-resgatar/">como resgatar</a>.</p></div></li>
        </ol>
      </>
    ) : (
      <>
        <h2>Como participar da edição {n}</h2>
        <ol class="steps">
          <li class="card"><span class="sn">1</span><div><h3>Compre o bilhete</h3><p class="muted">Pelo site oficial do Rio de Prêmios ou em canais autorizados indicados por ele.</p></div></li>
          <li class="card"><span class="sn">2</span><div><h3>Cadastre o bilhete</h3><p class="muted">Registre o bilhete com seus dados no site oficial. <a href="/rio-de-premios/bilhete-e-cadastro/">Veja o passo a passo</a>.</p></div></li>
          <li class="card"><span class="sn">3</span><div><h3>Guarde o comprovante</h3><p class="muted">Fotografe o bilhete e guarde o original até a conferência do resultado.</p></div></li>
          <li class="card"><span class="sn">4</span><div><h3>Acompanhe o sorteio</h3><p class="muted">Domingo, {dataBR(data)}. Depois, confira o resultado no site oficial.</p></div></li>
        </ol>
      </>
    )}
  </section>

  <div class="wrap"><Ad /></div>

  <section class="wrap section-sm">
    <h2>Dicas para a edição {n}</h2>
    <div class="grid g2">{dicas.map(([t, d]) => <div class="card"><h3 style="margin:0 0 6px">{t}</h3><p class="muted small" style="margin:0">{d}</p></div>)}</div>
  </section>

  <section class="wrap section-sm">
    <h2>Outras edições</h2>
    <div class="grid g3">
      {[n - 1, n + 1, n + 2].filter((x) => x >= RP.baseEdicao && x <= ultimaPublicada).map((x) => (
        <a class="card card-link" href={`/rio-de-premios/edicao/${x}/`}><strong>Rio de Prêmios {x}</strong><p class="small muted" style="margin:4px 0 0">Domingo, {dataBR(dataEdicao(x))}{x < prox ? ' · realizado' : x === prox ? ' · próximo sorteio' : ''}</p></a>
      ))}
    </div>
  </section>

  <section class="section-sm"><div class="narrow"><Faq itens={faq} titulo={`Dúvidas sobre o Rio de Prêmios ${n}`} /></div></section>
  <nav class="wrap pager" aria-label="Edições vizinhas">
    {n > RP.baseEdicao ? <a class="btn" href={`/rio-de-premios/edicao/${n - 1}/`} rel="prev">← Edição {n - 1}</a> : <span></span>}
    <a class="btn" href="/rio-de-premios/">Rio de Prêmios</a>
    {n < ultimaPublicada ? <a class="btn" href={`/rio-de-premios/edicao/${n + 1}/`} rel="next">Edição {n + 1} →</a> : <span></span>}
  </nav>
</Base>
<style>
  .rpe { display: grid; grid-template-columns: 1.3fr 1fr; gap: 22px; align-items: start; }
  .rpe-img { margin: 0; border-radius: var(--r); overflow: hidden; border: 1px solid var(--line); }
  .rpe-img img { width: 100%; height: auto; display: block; }
  .steps { list-style: none; padding: 0; margin: 16px 0 8px; display: grid; gap: 12px; }
  .steps li { display: flex; gap: 18px; align-items: flex-start; }
  .steps h3 { margin: 4px 0; }
  .steps p { margin: 0; }
  .sn { flex: none; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; font: 700 1.05rem var(--display); color: #04211f; background: linear-gradient(120deg, #2dd4bf, #f2c14e); }
  .pager { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin-top: 24px; }
  @media (max-width: 900px) { .rpe { grid-template-columns: 1fr; } }
</style>
