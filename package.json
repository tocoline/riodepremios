{
  "name": "riodepremios",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler pages dev ./dist",
    "db:migrate:local": "wrangler d1 migrations apply riodepremios --local",
    "db:migrate:remote": "wrangler d1 migrations apply riodepremios --remote",
    "deploy": "astro build && wrangler pages deploy ./dist",
    "coletor:deploy": "wrangler deploy -c workers/coletor/wrangler.toml"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/sitemap": "^3.7.6",
    "@cf-wasm/og": "^0.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.168.0"
  }
}
